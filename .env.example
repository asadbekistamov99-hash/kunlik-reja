# Optional build-time defaults. Every key can also be entered at runtime in
# Settings -> API kalitlari, where it is stored encrypted with the Android Keystore.
# Leave the placeholders as-is to ship a build with no embedded keys (recommended).

# Gemini API key for the online AI agent (function calling). Offline NLU is used without it.
GEMINI_API_KEY=MY_GEMINI_API_KEY
# Picovoice AccessKey enabling the exact "Jarvis" Porcupine wake word.
# Without it the bundled offline openWakeWord "hey Jarvis" model is used.
PICOVOICE_ACCESS_KEY=MY_PICOVOICE_ACCESS_KEY
# OpenAI key for the optional Whisper speech-to-text engine.
OPENAI_API_KEY=MY_OPENAI_API_KEY
